# tests/test_manual_review_real_files_e2e.py 전용 로컬 설정 (Git 제외 대상).
# 사내망 실제 VXvue 1.1.0 예시 파일(사내 기밀 문서라 리포지토리에는 커밋하지 않음)의
# 기준 폴더 경로를 여기에 채운다. 이 파일 자체(.example)만 공개하고, 실제 값을 채운
# real_fixtures.local.env는 .gitignore 대상이라 커밋되지 않는다.
#
# 이 파일이 없거나 경로가 존재하지 않으면 해당 E2E 테스트는 자동으로 skip된다
# (OPEN_QUESTIONS.md #5, HANDOFF.md 참고).

REAL_VXVUE_KNOWLEDGE_DIR=C:\path\to\VXvue 지식파일
REAL_VXVUE_DOC_DIR=\\host\share\path\to\VXvue\Test_Case\V1.1.0\Doc
