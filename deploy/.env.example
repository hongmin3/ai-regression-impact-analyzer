# QA Manual Hub -- environment template
#
# Copy to /opt/qa-manual-hub/.env on the server and fill in real values.
# NEVER commit the filled-in file.  Keep it chmod 600, owned by the service user.

# --- database -------------------------------------------------------------- #
# The application uses its own database and its own role, separate from any
# other database on the host.
DATABASE_URL=postgresql+psycopg://qamanual:REPLACE_WITH_A_STRONG_PASSWORD@127.0.0.1:5432/qa_manual_hub

# --- runtime --------------------------------------------------------------- #
ENVIRONMENT=production
DEBUG=false

# --- session --------------------------------------------------------------- #
SESSION_COOKIE_NAME=qamh_session
SESSION_LIFETIME_HOURS=8
# Set to true only once HTTPS terminates in front of the app.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- storage --------------------------------------------------------------- #
STORAGE_ROOT=/srv/qa-manual-hub/storage
MAX_UPLOAD_MB=500
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,png,jpg,jpeg

# --- password policy ------------------------------------------------------- #
# 1 = any non-empty password is accepted. Raise this to enforce a minimum
# length; the API, the CLI and the web forms all read this single value.
PASSWORD_MIN_LENGTH=1

# --- first-run admin bootstrap --------------------------------------------- #
# Used only by `python -m app.cli bootstrap-admin`.  Prefer typing the password
# at the interactive prompt and leaving these unset; if you do set
# BOOTSTRAP_ADMIN_PASSWORD, remove it from the file immediately afterwards.
BOOTSTRAP_ADMIN_LOGIN_ID=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME="QA Admin"
# BOOTSTRAP_ADMIN_PASSWORD=

# --- dev only -------------------------------------------------------------- #
# Comma-separated origins for the Vite dev server.  Leave empty in production
# (nginx serves the SPA from the same origin, so no CORS is involved).
CORS_ORIGINS=
